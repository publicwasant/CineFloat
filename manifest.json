{
  "manifest_version": 3,
  "name": "CineFloat",
  "version": "1.0",
  "description": "Universal Picture-in-Picture (PiP) extension for web video streaming.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"]
    }
  ]
}
