{
  "manifest_version": 3,
  "name": "CineFloat",
  "version": "1.0",
  "description": "Auto Picture-in-Picture extension for Disney+",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["content.js"]
    }
  ]
}
